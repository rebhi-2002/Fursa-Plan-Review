# =============================================================================
# Fursa — Environment Variables Template
# =============================================================================
#
# This file is a TEMPLATE. It lists every key the project reads at runtime.
# Copy it to ".env" and fill in real values, OR (recommended) set each key
# in the Replit Secrets panel — Replit injects secrets into the runtime
# exactly like a .env file, but keeps values out of source control.
#
# All keys here are already present in this Repl's Secrets, so the app runs
# out of the box. Use this file purely as a reference of what can be changed.
#
# IMPORTANT: never commit a real .env file. .env is in .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# The full Postgres connection string used by Drizzle ORM (lib/db).
# Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
#
# • Replit-provisioned Postgres: this is auto-set, do not change.
# • Supabase: copy "Connection string → URI" from
#     Supabase Dashboard → Project Settings → Database → Connection String
#   It looks like:
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional individual Postgres parts (only used by some tooling, not the app):
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=


# -----------------------------------------------------------------------------
# Clerk Authentication (https://clerk.com)
# -----------------------------------------------------------------------------
# Backend secret key — used by the API server to verify sessions.
#   Format: sk_test_... (development) or sk_live_... (production)
CLERK_SECRET_KEY=

# Frontend publishable key — embedded in the browser bundle.
#   Format: pk_test_... (development) or pk_live_... (production)
CLERK_PUBLISHABLE_KEY=


# -----------------------------------------------------------------------------
# Supabase (optional — only if you choose Supabase as a separate API layer)
# -----------------------------------------------------------------------------
# Supabase project URL (REST API base). Used by the frontend supabase-js client
# if you ever wire it. Drizzle/Postgres do NOT use this — they use DATABASE_URL.
#   Format: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (public) key for the frontend supabase-js client.
# Safe to expose to the browser.
Fursa_DB_Key=


# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
# Random string used to sign sessions. Replace with a long random value in prod.
SESSION_SECRET=


# -----------------------------------------------------------------------------
# Replit-managed (auto-injected, do NOT set manually)
# -----------------------------------------------------------------------------
# REPLIT_DOMAINS=
# REPLIT_DEV_DOMAIN=
# REPL_ID=
# PORT=
